      { t: zh ? '黄金' : 'Gold', d: zh ? '现货黄金与贵金属' : 'Spot gold and metals', i: '金', soon: true },
      { t: zh ? '美股' : 'US Stocks', d: zh ? '美股市场热门标的' : 'Popular US equities', i: 'US', href: '/stocks/' },
      { t: zh ? '市场资讯' : 'Market News', d: zh ? '全球市场新闻与数据' : 'Global market news and data', i: '讯', soon: true }
    ]}
  ];

  var AI_MENU = [
    { title: 'AI', items: [
      { t: zh ? 'AI 客服' : 'AI Support', d: zh ? '智能问答与平台使用指引' : 'Smart Q&A and platform guidance', i: 'AI', action: 'ai' },
      { t: zh ? '交易机器人' : 'Trading Bot', d: zh ? '智能策略，自动交易' : 'Automated trading strategies', i: '机', soon: true },
      { t: '跟单', d: zh ? '跟随专家实现收益增长' : 'Copy expert strategies', i: '跟', soon: true },
      { t: zh ? '分享好友' : 'Invite Friends', d: zh ? '邀请好友，共享返佣' : 'Invite friends and earn rewards', i: '邀', go: '/promote' },
      { t: zh ? '合约入门' : 'Futures Guide', d: zh ? '从零开始掌握合约交易技巧' : 'Learn futures trading', i: '入', go: '/help' },
      { t: zh ? '储备金证明' : 'Proof of Reserves', d: zh ? '客户负债与链上储备对照' : 'Liabilities vs on-chain reserves', i: '证', soon: true }
    ]}
  ];

  var WELFARE_MENU = [
    { title: zh ? '福利中心' : 'Rewards', items: [
      { t: zh ? '分享好友' : 'Invite Friends', d: zh ? '邀请好友，获得返佣奖励' : 'Invite friends and earn commission', i: '邀', go: '/promote' },
      { t: zh ? '合约活动' : 'Futures Campaigns', d: zh ? '查看合约活动与参与规则' : 'Futures events and rules', i: '合约', go: '/promote' },
      { t: zh ? '股票活动' : 'Stock Campaigns', d: zh ? '查看股票活动与参与规则' : 'Stock events and rules', i: '股票', go: '/promote' },
      { t: zh ? '每日签到' : 'Daily Check-in', d: zh ? '每日签到领取积分奖励' : 'Daily rewards', i: '签', soon: true },
      { t: zh ? '任务中心' : 'Task Center', d: zh ? '完成任务领取福利' : 'Complete tasks for rewards', i: '任', soon: true }
    ]}
  ];

  var COMMUNITY_MENU = [
    { title: zh ? '币圈' : 'Community', items: [
