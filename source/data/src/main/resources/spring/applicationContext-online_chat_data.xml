<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans         
	    http://www.springframework.org/schema/beans/spring-beans.xsd">         
		
	<bean id="onlineChatMessageService" class="project.onlinechat.internal.OnlineChatMessageServiceImpl" init-method="init">
		<property name="tipService" ref="tipService" />
		<property name="partyService" ref="partyService" />
		<property name="customerService" ref="customerService" />
		<property name="userRecomService" ref="userRecomService" />
	</bean>
	
	<bean id="onlineChatVisitorMessageService" class="project.onlinechat.internal.OnlineChatVisitorMessageServiceImpl">
		<property name="tipService" ref="tipService" />
		<property name="customerService" ref="customerService" />
		<property name="onlineChatMessageService" ref="onlineChatMessageService" />
	</bean>
	
	<bean id="otcOnlineChatMessageService" class="project.onlinechat.otc.internal.OtcOnlineChatMessageServiceImpl" init-method="init">
		<property name="partyService" ref="partyService" />
		<property name="userRecomService" ref="userRecomService" />
		<property name="tipService" ref="tipService" />
		<property name="c2cOrderService" ref="c2cOrderService" />
	</bean>
</beans>
