	<bean id="etherscanService" class="project.monitor.etherscan.internal.EtherscanServiceImpl">
		<property name="sysparaService" ref="sysparaService" />
	</bean>
	
	<bean id="autoMonitorSettleAddressConfigService" class="project.monitor.bonus.internal.AutoMonitorSettleAddressConfigServiceImpl"/>
		
	<bean id="settleOrderService" class="project.monitor.bonus.internal.SettleOrderServiceImpl"/>
		
	<bean id="autoMonitorPoolMiningDataService" class="project.monitor.internal.AutoMonitorPoolMiningDataServiceImpl">
