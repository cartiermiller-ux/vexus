<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans         
	    http://www.springframework.org/schema/beans/spring-beans.xsd">         
	
	<bean id="dataService" class="project.data.internal.DataServiceImpl">
		<property name="remoteDataService" ref="remoteDataService" />
		<property name="sysparaService" ref="sysparaService" />
	</bean>
	
	<bean id="remoteDataService" class="kernel.web.RmiProxyFactoryBean" factory-method="getProxyBean">
		<constructor-arg name="remoteContextPath" value="/data"/>
		<constructor-arg name="remoteBeanName" value="dataService"/>
		<constructor-arg name="remoteInterface" value="project.data.DataService"/>
	</bean>
</beans>