<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans         
	    http://www.springframework.org/schema/beans/spring-beans.xsd">         
		
	<bean id="tipService" class="kernel.web.RmiProxyFactoryBean" factory-method="getProxyBean">
		<constructor-arg name="remoteBeanName" value="tipService"/>
		<constructor-arg name="remoteInterface" value="project.tip.TipService"/>
	</bean>
</beans>