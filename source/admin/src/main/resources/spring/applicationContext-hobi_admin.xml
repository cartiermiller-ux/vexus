<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans         
	    http://www.springframework.org/schema/beans/spring-beans.xsd">         
	
	<bean id="hobiDataService" class="kernel.web.RmiProxyFactoryBean" factory-method="getProxyBean">
		<constructor-arg name="remoteBeanName" value="hobiDataService"/>
		<constructor-arg name="remoteInterface" value="project.hobi.HobiDataService"/>
	</bean>
	
	<bean id="remoteDataService" class="kernel.web.RmiProxyFactoryBean" factory-method="getProxyBean">
		<constructor-arg name="remoteContextPath" value="/data"/>
		<constructor-arg name="remoteBeanName" value="dataService"/>
		<constructor-arg name="remoteInterface" value="project.data.DataService"/>
	</bean>
		
	<bean id="klineInitService" class="kernel.web.RmiProxyFactoryBean" factory-method="getProxyBean">
		<constructor-arg name="remoteBeanName" value="klineInitService"/>
		<constructor-arg name="remoteInterface" value="project.data.internal.KlineInitService"/>
	</bean>
		
	<bean id="dataService" class="project.data.internal.DataServiceImpl">
		<property name="remoteDataService" ref="remoteDataService" />
		<property name="sysparaService" ref="sysparaService" />
	</bean>
		
	<bean id="adminSymbolsService" class="project.hobi.internal.AdminSymbolsServiceImpl">
		<property name="pagedQueryDao" ref="pagedDao"/>
		<property name="hobiDataService" ref="hobiDataService"/>
	</bean>
	
	<bean id="adminContractSymbolsService" class="project.hobi.internal.AdminContractSymbolsServiceImpl">
		<property name="hobiDataService" ref="hobiDataService" />
	</bean>
</beans>